{
  "name": "@syntropiq/pyrex",
  "version": "0.1.0",
  "description": "A TypeScript library providing a Python-like regex interface with automatic backend selection",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write src/**/*.{ts,tsx}",
    "format:check": "prettier --check src/**/*.{ts,tsx}",
    "dev": "vite",
    "preview": "vite preview",
    "prepublishOnly": "bun run lint && bun run test:run && bun run build"
  },
  "keywords": [
    "regex",
    "typescript",
    "python",
    "re",
    "pattern",
    "matching"
  ],
  "author": "Syntropiq",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/syntropiq/pyrex.git"
  },
  "bugs": {
    "url": "https://github.com/syntropiq/pyrex/issues"
  },
  "homepage": "https://github.com/syntropiq/pyrex#readme",
  "devDependencies": {
    "@types/bun": "latest",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "core-js": "^3.39.0",
    "pyodide": "^0.26.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "publishConfig": {
    "access": "public"
  }
}
