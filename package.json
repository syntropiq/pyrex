{
  "name": "@syntropiq/pyrex",
  "version": "0.1.0",
  "description": "A TypeScript library providing a Python-like regex interface with Python-only implementation",
  "main": "dist/index.esm.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun run lint:fix && bun run format && vite build",
    "build:clean": "vite build",
    "test": "vitest run --bail 1",
    "test:watch": "vitest watch --bail 1",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write src/**/*.ts",
    "format:check": "prettier --check src/**/*.ts",
    "dev": "vite",
    "preview": "vite preview",
    "prepublishOnly": "bun run lint && bun run test && bun run build:clean"
  },
  "keywords": [
    "regex",
    "typescript",
    "python",
    "re",
    "pattern",
    "matching"
  ],
  "author": "Syntropiq",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/syntropiq/pyrex.git"
  },
  "bugs": {
    "url": "https://github.com/syntropiq/pyrex/issues"
  },
  "homepage": "https://github.com/syntropiq/pyrex#readme",
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "@typescript-eslint/parser": "^8.33.1",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^9.1.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.2"
  },
  "dependencies": {
    "pyodide": "^0.27.7"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "publishConfig": {
    "access": "public"
  }
}
